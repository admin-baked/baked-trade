# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# LLM selection (openai | anthropic | google | xai | deepseek | dashscope | zhipu | openrouter)
LLM_PROVIDER=openai

# ── Alpaca Broker ──────────────────────────────────────────────────────────────
# Get keys at https://alpaca.markets (paper account is free)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ALPACA_PAPER=true means paper trading (safe default). Set to false for live money.
ALPACA_PAPER=true

# ── Execution controls ─────────────────────────────────────────────────────────
# EXECUTION_ENABLED=false = analysis only (no orders submitted, ever)
# Set to true only after validating paper trades for 60+ days
EXECUTION_ENABLED=false

# ── Risk controls ──────────────────────────────────────────────────────────────
MAX_POSITION_PCT=0.05      # Max 5% of portfolio per position
MAX_DAILY_DRAWDOWN=0.03    # Halt trading if down 3% on the day
MAX_OPEN_POSITIONS=10      # Max concurrent open positions

# ── Daily run config ───────────────────────────────────────────────────────────
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA

# ── Notifications ──────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
